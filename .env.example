# Where the qualification + contact forms POST their JSON (Make, Zapier, n8n, Formspree, HubSpot webhook, etc.)
# Leave empty and the forms fall back to sending the answers via WhatsApp (nothing is "faked").
NEXT_PUBLIC_FORM_ENDPOINT=
# Optional scheduling link (Calendly, Cal.com, Google Calendar booking page) shown after a successful submission
NEXT_PUBLIC_BOOKING_URL=
# Optional analytics: Google Analytics 4 measurement ID (G-XXXXXXX). Leave empty = no analytics, no cookies.
NEXT_PUBLIC_GA_ID=
